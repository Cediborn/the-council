# COUNCIL model configuration — all server-side. Never expose keys to the client.

# Ollama local provider (default, free, no API key needed)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional cloud provider — leave empty to use Ollama.
# If both a cloud key and OLLAMA_URL are present, CLOUD_PRIORITY decides which wins.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Which provider to prefer when multiple are configured: "ollama" | "openrouter" | "anthropic" | "openai"
# COUNCIL_PROVIDER=ollama

# V0.2 per-stage model routing — pin a stage to a different model if desired
# (e.g. a cheap model for analysis, a stronger one for the Judge).
# COUNCIL_MODEL_ANALYSIS=
# COUNCIL_MODEL_COMPARISON=
# COUNCIL_MODEL_DEVILS_ADVOCATE=
# COUNCIL_MODEL_REASSESSMENT=
# COUNCIL_MODEL_JUDGE=

# Per-call timeout in ms (default: 180000 for Ollama, 120000 for cloud).
# COUNCIL_TIMEOUT_MS=180000
